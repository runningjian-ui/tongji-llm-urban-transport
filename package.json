    "build:all": "npm run docs:build && npm run slidev:build"
  },
  "devDependencies": {
    "@slidev/cli": "^0.50.0",
    "@slidev/theme-default": "^0.25.0",
    "@slidev/theme-seriph": "^0.25.0",
    "vitepress": "^1.5.0",
    "vue": "^3.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
