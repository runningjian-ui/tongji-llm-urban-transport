{
  "name": "tongji-llm-urban-transport",
  "version": "1.0.0",
  "description": "LLM-Powered Urban Transportation Governance @ Tongji University",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "slidev:dev": "slidev lectures/01-introduction/slides/slides.md --open",
    "slidev:build": "slidev build lectures/01-introduction/slides/slides.md --out dist/slides/01",
